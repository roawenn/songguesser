# Bu dosyayı .env.local olarak kopyalayıp doldur. .env.local git'e girmez.

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Gizli: yalnızca sunucu tarafında kullanılır, tarayıcıya ASLA gitmez.
SUPABASE_SECRET_KEY=sb_secret_...

# Yönetim paneli girişi.
# ADMIN_PASSWORD artık YOK — şifre veritabanında (npm run admin:parola)

# Yalnızca migration script'i için. Ücretsiz planda doğrudan bağlantı (db.<ref>...)
# yalnızca IPv6 olduğundan pooler kullanılır.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<sifre>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Google ile giriş (Günlük sıralaması). Google Auth Platform → Clients → Web.
# Yetkili yönlendirme adresleri: https://tahmin.net/api/giris/google/donus ve
# http://localhost:3000/api/giris/google/donus. Vercel'de Production ve
# Development ortamına girin; Preview'a GİRMEYİN (önizleme adresleri kayıtlı değil).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İsteğe bağlı: yönlendirme adresini sabitlemek için.
# GOOGLE_REDIRECT_URI=
